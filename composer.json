{
    "name": "cubical6/structurizr-mcp",
    "description": "Model Context Protocol (MCP) server for Structurizr - Create and manage C4 architecture diagrams as code",
    "type": "project",
    "keywords": [
        "mcp",
        "model-context-protocol",
        "structurizr",
        "c4-model",
        "architecture",
        "diagrams-as-code"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Cubical6"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0",
        "mcp/sdk": "dev-main",
        "monolog/monolog": "^3.0",
        "psr/simple-cache": "^3.0",
        "symfony/cache": "^6.0|^7.0",
        "symfony/filesystem": "^6.0|^7.0",
        "symfony/process": "^6.0|^7.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "jbelien/phpstan-sarif-formatter": "^1.2",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "StructurizrMcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StructurizrMcp\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse src --level=8",
        "cs-fix": "php-cs-fixer fix src",
        "server": "php server.php"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
